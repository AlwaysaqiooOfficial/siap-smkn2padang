# ============================
# APP
# ============================
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# ============================
# SUPABASE (pilih ini untuk database produksi; jangan commit service role key)
# ============================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================
# DATABASE
# ============================
DATABASE_URL="mysql://root:password@localhost:3306/siap_smkn2_padang"

# ============================
# JWT
# ============================
# Minimal 32 karakter acak. Generate contoh: openssl rand -base64 48
JWT_SECRET=ubah_dengan_secret_acak_minimal_32_karakter_yang_sangat_rahasia
JWT_EXPIRES_IN=8h

# Vercel memakai reverse proxy. Production otomatis trust satu proxy; set true juga
# bila memakai proxy pada development/staging.
TRUST_PROXY=false

# ============================
# SMTP GMAIL (Nodemailer) — Phase 5
# Gunakan App Password Gmail (16 digit), BUKAN password akun biasa.
# Cara buat: Google Account -> Security -> 2-Step Verification -> App Passwords
# ============================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=akun.sekolah@gmail.com
SMTP_PASS=app_password_gmail_16_digit
SMTP_FROM_NAME=SIAP SMKN 2 PADANG

# ============================
# ABSENSI DEFAULT (bisa dioverride via school_settings di DB)
# ============================
ATTENDANCE_START_TIME=05:00
ATTENDANCE_LATE_AFTER=07:30
ATTENDANCE_END_TIME=10:00
AUTO_ALFA_CRON_TIME=10:00
